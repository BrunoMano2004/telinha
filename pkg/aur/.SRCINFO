pkgbase = telinha-git
	pkgdesc = Compartilhamento de tela leve e de baixa latência pelo navegador (WebRTC + encoder de hardware), com card para o Caelestia
	pkgver = r5.7b402ac
	pkgrel = 1
	url = https://github.com/BrunoMano2004/telinha
	install = telinha.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = glib2
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-base-libs
	depends = gst-plugins-good
	depends = gst-plugins-bad
	depends = gst-plugins-bad-libs
	depends = gst-plugin-pipewire
	depends = libnice
	depends = pipewire
	depends = pipewire-pulse
	depends = xdg-desktop-portal
	depends = cloudflared
	optdepends = caelestia-shell: card "Screen share" no painel de utilidades (rode telinha-caelestia)
	optdepends = gst-plugin-va: encoder H.264 por hardware em GPUs Intel/AMD
	optdepends = gst-plugins-ugly: encoder x264 (fallback sem encoder de hardware)
	optdepends = tailscale: link privado dentro da tailnet (telinha sem --tunnel)
	provides = telinha
	conflicts = telinha
	source = telinha::git+https://github.com/BrunoMano2004/telinha.git
	sha256sums = SKIP

pkgname = telinha-git
